# Timesheet Manager - Example Environment Variables
# SMTP (Gmail via Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PontoFlow <no-reply@yourdomain.com>"

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# i18n
NEXT_PUBLIC_DEFAULT_LOCALE=pt-BR
NEXT_PUBLIC_AVAILABLE_LOCALES=pt-BR,en-GB


# Web Push (VAPID) - opcional
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Capacitor (mobile white-label) - opcional
# appId/nome do app usados por `npx cap sync` (web/capacitor.config.ts)
CAPACITOR_APP_ID=com.pontoflow.app
CAPACITOR_APP_NAME=PontoFlow

