# PontoFlow Mobile - Environment Configuration
# Copy this file to .env and fill in the values
# cp .env.example .env

# ============================================
# Supabase Configuration (Required)
# ============================================
# Get these values from your Supabase project dashboard:
#   Settings > API > Project API keys
#   Settings > API > Project URL
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# ============================================
# API Configuration (Required)
# ============================================
# URL of your Next.js API server
# 
# Development options:
#   - Android emulator: http://10.0.2.2:3000/api
#   - iOS simulator:    http://localhost:3000/api
#   - Physical device:  http://<YOUR_PC_IP>:3000/api
# 
# Production:
#   https://your-domain.com/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api

# ============================================
# Optional Configuration
# ============================================

# Enable debug logging (set to '1' for debug mode)
EXPO_DEBUG=0

# Enable offline mode (sync operations when offline)
EXPO_OFFLINE_MODE=1
